# Local development template only. Generate every value marked below locally.
POSTGRES_DB=orvexadb
POSTGRES_USER=orvexadb
# Required: replace with a unique random local password. Never publish it.
POSTGRES_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgresql+psycopg://orvexadb:replace-with-a-local-random-password@db:5432/orvexadb
API_INTERNAL_URL=http://api:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Required: generate at least 32 random bytes. Never publish it.
AUTH_PEPPER=replace-with-a-random-32-byte-or-longer-secret
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
ALLOWED_ORIGINS=http://localhost:3000
